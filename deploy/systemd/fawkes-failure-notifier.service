[Unit]
Description=Deliver pending sanitized Fawkes component failure receipts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tvnner
Group=tvnner
WorkingDirectory=/home/tvnner/.local/lib/fawkes-production/current
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/home/tvnner/.config/fawkes/notification.env
ExecStart=/usr/bin/python3 -B /home/tvnner/.local/lib/fawkes-production/run_fawkes_release.py scripts/fawkes_failure_notifier.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/tvnner/.local/state/fawkes
ReadWritePaths=/home/tvnner/fawkes/component-receipts /home/tvnner/fawkes/pending-failure-notifications
