After=network-online.target
Before=fawkes-app.service fawkes-discord.service

[Service]
Type=oneshot
User=tvnner
Group=tvnner
ExecStart=/usr/bin/python3 -B /home/tvnner/.local/lib/fawkes-production/run_fawkes_release.py scripts/verify_fawkes_production_prerequisites.py --component app
