[Unit]
Description=Fawkes private mobile/PWA server
After=network-online.target fawkes-production-ready.service
Wants=network-online.target
Requires=fawkes-production-ready.service
PartOf=fawkes.target
OnFailure=fawkes-failure-notifier.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tvnner
Group=tvnner
WorkingDirectory=/home/tvnner/.local/lib/fawkes-production/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=FAWKES_APP_HOST=0.0.0.0
Environment=FAWKES_APP_PORT=8787
Environment=FAWKES_DEVELOPMENT_ROOT=/home/tvnner/fawkes
Environment=FAWKES_RUNTIME_STATE_ROOT=/home/tvnner/.local/state/fawkes
EnvironmentFile=/home/tvnner/.config/fawkes/app.env
EnvironmentFile=-/home/tvnner/.config/fawkes/notification.env
ExecStart=/home/tvnner/.local/lib/fawkes-production/venv/bin/python -B -m src.app.server --host 0.0.0.0 --port 8787
ExecStartPost=/home/tvnner/.local/lib/fawkes-production/venv/bin/python -B scripts/wait_fawkes_app_ready.py
ExecStopPost=/home/tvnner/.local/lib/fawkes-production/venv/bin/python -B scripts/fawkes_component_failure.py app_server --result ${SERVICE_RESULT} --exit-code ${EXIT_CODE} --exit-status ${EXIT_STATUS}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/tvnner/fawkes/archive /home/tvnner/fawkes/database /home/tvnner/fawkes/memory /home/tvnner/fawkes/library /home/tvnner/fawkes/conversations /home/tvnner/fawkes/instances /home/tvnner/fawkes/logs /home/tvnner/.local/state/fawkes

[Install]
WantedBy=fawkes.target
