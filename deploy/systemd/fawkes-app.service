[Unit]
Description=Fawkes private mobile/PWA server
After=network-online.target
Wants=network-online.target
PartOf=fawkes.target
OnFailure=fawkes-failure-notifier.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tvnner
Group=tvnner
WorkingDirectory=/home/tvnner/fawkes
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=FAWKES_APP_HOST=0.0.0.0
Environment=FAWKES_APP_PORT=8787
EnvironmentFile=/home/tvnner/.config/fawkes/app.env
ExecStart=/home/tvnner/fawkes/.venv/bin/python -B -m src.app.server --host 0.0.0.0 --port 8787
ExecStartPost=/home/tvnner/fawkes/.venv/bin/python -B /home/tvnner/fawkes/scripts/wait_fawkes_app_ready.py
ExecStopPost=/home/tvnner/fawkes/.venv/bin/python -B /home/tvnner/fawkes/scripts/fawkes_component_failure.py app_server --result ${SERVICE_RESULT} --exit-code ${EXIT_CODE} --exit-status ${EXIT_STATUS}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/tvnner/fawkes/Archive /home/tvnner/fawkes/database /home/tvnner/.local/state/fawkes

[Install]
WantedBy=fawkes.target
