config/local.*

# Database files are runtime state unless a reviewed fixture is explicitly
# force-added in a dedicated synthetic test-fixture directory.
*.sqlite
*.sqlite3
*.db

# Fawkes runtime state — keep outside source control
/archive/
/backups/
/database/
/conversations/
/instances/

# Phoenix derived runtime state — private and rebuildable where applicable
/memory/
/library/
