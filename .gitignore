*:*Zone.Identifier

# Build, dependency, and generated distribution output
build/
dist/
*.egg-info/
node_modules/
*.whl
/browser_extension/*.tar.gz
/browser_extension/*.zip
/fawkes-*.tar.gz
/fawkes-*.zip

# Temporary and machine-local configuration
tmp/
temp/
*.tmp
*.local
